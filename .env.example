# ============================================================
# PledgeBond — Environment Variables
# ============================================================
# Production secrets are managed via GCP Secret Manager.
# Run ./scripts/sync-secrets.sh to pull them into Vercel.
#
# Local development: copy this file to .env.local and fill in values.
# ============================================================

# Blockchain Configuration
PRIVATE_KEY=your_private_key_for_deployment
INFURA_API_KEY=your_infura_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
REPORT_GAS=true

# RPC URLs for Testnet Deployment
ETHEREUM_SEPOLIA_RPC=https://sepolia.infura.io/v3/your_infura_key
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org
OPTIMISM_SEPOLIA_RPC=https://sepolia.optimism.io
CELO_ALFAJORES_RPC=https://alfajores-forno.celo-testnet.org
LINEA_SEPOLIA_RPC=https://rpc.sepolia.linea.build

# Frontend Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Solana (Frontend)
# Program id will be created on deploy (see blockchain-solana/README.md for steps).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
# Deployed at DVzV16mVG9vHdrum9Fx9kGhzRv2GJa2mNnmTWUnKa6st (split vault architecture)
NEXT_PUBLIC_SOLANA_PROGRAM_ID=DVzV16mVG9vHdrum9Fx9kGhzRv2GJa2mNnmTWUnKa6st

# Contract Addresses
# LiquidityRail + HackathonRegistry are deployed via:
#   cd blockchain && npx hardhat run scripts/deployTestnet.js --network <arcTestnet|arc>
# Arc Testnet addresses are the fallbacks baked into frontend/src/config/tokens.js;
# these env vars override them (and are the ONLY way to point at Arc Mainnet).
NEXT_PUBLIC_LIQUIDITY_RAIL_TESTNET_ADDRESS=
NEXT_PUBLIC_HACKATHON_REGISTRY_TESTNET_ADDRESS=
NEXT_PUBLIC_LIQUIDITY_RAIL_ADDRESS=
NEXT_PUBLIC_HACKATHON_REGISTRY_ADDRESS=

# Circle API (REQUIRED for hackathon)
CIRCLE_API_KEY=your_circle_sandbox_api_key
CIRCLE_WALLET_SET_ID=your_wallet_set_id
CIRCLE_ENTITY_SECRET=your_entity_secret
CIRCLE_ENVIRONMENT=sandbox
# Webhook secret for verifying Circle push notifications (HMAC-SHA256)
# Set in Circle dashboard: https://developers.circle.com → Webhooks
CIRCLE_WEBHOOK_SECRET=your_webhook_secret

# LI.FI API (REQUIRED for hackathon)
NEXT_PUBLIC_LIFI_API_KEY=your_lifi_api_key

# GitHub API — server-side only. Used for repo metadata and commit history.
#
# DO NOT `export GITHUB_TOKEN` in your shell. The gh CLI and git both read
# GITHUB_TOKEN in preference to keyring auth, so an expired token exported in
# your shell silently breaks every git push with:
#   "Invalid username or token. Password authentication is not supported."
# and makes `gh auth status` report a failure even though your keyring login
# is fine. Verify with:
#   gh auth git-credential get <<< $'protocol=https\nhost=github.com\n\n'
#   # username=thisyearnofear is correct; x-access-token means the env var won
# Leave this unset in .env/.env.local for git work — the app only reads it in
# server-side code paths. Use `gh auth switch --user <account>` for git ops.
GITHUB_TOKEN=your_github_personal_access_token

# MetaMask SDK (for bonus points)
NEXT_PUBLIC_METAMASK_PROJECT_ID=your_metamask_project_id

# AIsa x402 Nanopayments (agent-to-agent payments on Arc Testnet)
# Generate mnemonic: node -e "import('viem/accounts').then(m=>console.log(m.generateMnemonic(require('viem/accounts').english)))"
# Fund with testnet USDC: https://faucet.circle.com (select Arc Testnet)
OWS_MNEMONIC=your twelve word mnemonic phrase here

# Circle Gateway wallet — receives inbound 402 payments from callers of /api/agent/*
# Create via Circle Developer Console: https://developers.circle.com
CIRCLE_GATEWAY_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Circle platform wallet for outbound developer funding payouts
# Obtain the wallet ID from your Circle Developer Console
CIRCLE_PLATFORM_WALLET_ID=your_circle_platform_wallet_id

# Circle Agent Wallet ID — managed in Circle Console (developers.circle.com)
# The agent wallet holds USDC for on-chain backings via execute.js.
# Circle holds the private key; you set spending policies in the Console.
# Create the wallet in Circle Console → Wallets, then paste its ID here.
CIRCLE_AGENT_WALLET_ID=your_circle_agent_wallet_id

# PRIVATE_KEY is no longer needed by the agent (migrated to Circle Agent Wallets).
# Keep only if you need it for Hardhat contract deployment (blockchain/.env).

# LiquidityRail proxy address (NOT the implementation) used by the server-side
# Circle allowlist (RealCircleService). Note: server-only, no NEXT_PUBLIC_.
# UUPS proxy address (not the implementation address — the proxy)
LIQUIDITY_RAIL_ADDRESS=

# Agent API Key — required in production for protected agent and payout endpoints.
# Protected endpoints fail closed when this is missing in production.
# Requests must include an `x-api-key` header.
# Generate with: openssl rand -hex 32
# AGENT_API_KEY=your_secret_api_key_here

# Test mode — skip nanopayment verification (explicit opt-in)
# NEVER set to "true" in production. The middleware blocks it regardless.
# Set to "true" only for local development without real USDC.
ALLOW_DEMO_PAYMENTS=false

# Featherless AI — primary LLM for /api/agent/chat (DeepSeek-V3-0324)
# Get a key at: https://featherless.ai
FEATHERLESS_API_KEY=your_featherless_api_key

# Slack webhook for payout lead notifications
# When set, every new payout lead submission is posted to this Slack channel.
# Create a webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Secret for protecting the auto-process payout leads cron endpoint.
# Vercel cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=your_cron_secret

# Attestcoin / Creditcoin integration (BUIDL CTC 2026)
# Set to "true" to use the real UscAttestcoinClient once the PledgeBond ASC is deployed.
ATTESTCOIN_ENABLED=false
ATTESTCOIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ATTESTCOIN_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/
ATTESTCOIN_SOURCE_CHAIN=sepolia

# GenLayer jury (Agent Tank — Future of Work)
# MilestoneArbiter Intelligent Contract on GenLayer testnet.
# Deploy: paste genlayer/contracts/milestone_arbiter.py into https://studio.genlayer.com/contracts
# Faucet: https://testnet-faucet.genlayer.foundation/
GENLAYER_RPC_URL=
GENLAYER_CONTRACT_ADDRESS=
# Set to "true" to force offline mock verdicts (same interface, no chain call).
GENLAYER_MOCK=false
