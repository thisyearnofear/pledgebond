{
  "installCommand": "cd .. && pnpm install --filter ./frontend",
  "buildCommand": "cd .. && pnpm --filter ./frontend build",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/:path*" }],
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/payout-leads/process",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/leaderboard/snapshot",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/hackathons/ingest-devpost",
      "schedule": "0 2 * * *"
    }
  ]
}
