{
  "name": "pledgebond",
  "version": "1.0.0",
  "description": "Decentralized platform for hackathon funding and milestone verification",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter ./frontend dev",
    "build": "pnpm --filter ./frontend build",
    "clean": "pnpm -r run clean",
    "start": "pnpm --filter ./frontend start",
    "export": "pnpm --filter ./frontend export",
    "deploy": "npm run export && firebase deploy",
    "blockchain:test": "cd blockchain && npm run test",
    "blockchain:compile": "cd blockchain && npm run compile",
    "blockchain:deploy:local": "cd blockchain && npm run deploy:local",
    "blockchain:deploy:sepolia": "cd blockchain && npm run deploy:sepolia",
    "blockchain:deploy:mumbai": "cd blockchain && npm run deploy:mumbai",
    "blockchain:node": "cd blockchain && npm run node",
    "setup": "pnpm install && node scripts/setup-env.js && node scripts/cleanup.js",
    "setup-env": "node scripts/setup-env.js",
    "cleanup": "node scripts/cleanup.js",
    "sync-github": "node scripts/sync-github.js",
    "snap:dev": "cd snap-server && npx ts-node src/index.ts",
    "lint:frontend": "pnpm --filter ./frontend lint",
    "lint:contracts": "pnpm --filter ./blockchain lint",
    "lint": "npm run lint:frontend && npm run lint:contracts"
  },
  "keywords": [
    "ethereum",
    "smart-contracts",
    "solidity",
    "hardhat",
    "hackathon",
    "defi",
    "funding"
  ],
  "author": "",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "dotenv": "^16.0.3",
    "firebase-admin": "^13.4.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@circle-fin/x402-batching@3.5.0": "patches/@circle-fin__x402-batching@3.5.0.patch"
    }
  }
}
