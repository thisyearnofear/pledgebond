rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for access control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isProjectOwner(col, projectId) {
      let userId = request.auth.uid;
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/$(col)/$(projectId)) &&
             get(/databases/$(database)/documents/$(col)/$(projectId)).data.owners.hasAny([userId]);
    }

    function isCampaignOwner(campaignId) {
      let campaign = get(/databases/$(database)/documents/TestingCampaigns/$(campaignId)).data;
      return isAuthenticated() && isProjectOwner('projects', campaign.projectId);
    }

    // Projects are public, but all writes go through trusted server APIs.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles are private. Security-sensitive fields are server-managed.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdminUser());
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['permissions', 'role', 'isAdmin', 'apiKey', 'verifiedWinner', 'winnerData']);
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['permissions', 'role', 'isAdmin', 'apiKey', 'verifiedWinner', 'winnerData']);
      allow delete: if false;
    }

    match /developer_api_keys/{id} { allow read, write: if false; }
    match /api_key_idempotency/{id} { allow read, write: if false; }
    match /developer_api_audit/{id} { allow read, write: if false; }
    match /project_repository_index/{id} { allow read, write: if false; }

    // Drafts — per-user project drafts for auto-save persistence
    match /drafts/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Admin queue - authenticated users can add entries for their submissions
    match /admin_queue/{queueId} {
      allow read: if isAdminUser();
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isAdminUser();
    }

    // GitHub cache - public read (populated by sync script)
    match /github_cache/{cacheId} {
      allow read: if true;
      allow write: if false; // Only written by admin scripts
    }

    // Pending permissions collection
    // Docs are created by `blockchain/scripts/auto-grant-permissions.js` with
    // a `githubUsername` field. A user can read the docs addressed to them
    // (looked up from their `users/{uid}.githubUsername` profile); admins read all.
    match /pendingPermissions/{permissionId} {
      allow read: if isAdminUser() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.githubUsername
          == resource.data.githubUsername;
      allow write: if isAdminUser();
    }

    // Testing Campaigns
    match /TestingCampaigns/{campaignId} {
      allow read: if resource.data.status == 'open' || 
                     isProjectOwner('projects', resource.data.projectId) || 
                     isAdminUser();
      allow create, update, delete: if isProjectOwner('projects', resource.data.projectId) || isAdminUser();
    }

    // Campaign Submissions
    match /CampaignSubmissions/{submissionId} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.testerId) || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.testerId && 
                       get(/databases/$(database)/documents/TestingCampaigns/$(request.resource.data.campaignId)).data.status == 'open';
      allow update: if (isAuthenticated() && request.auth.uid == resource.data.testerId && resource.data.status == 'draft') || 
                       isCampaignOwner(resource.data.campaignId) || 
                       isAdminUser();
      allow delete: if isCampaignOwner(resource.data.campaignId) || isAdminUser();
    }

    // Token Allocations
    match /TokenAllocations/{allocationId} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.testerId) || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      allow create: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      allow update: if (isAuthenticated() && request.auth.uid == resource.data.testerId && 
                       request.resource.data.status in ['accepted', 'rejected']) ||
                      isCampaignOwner(request.resource.data.campaignId) || 
                      isAdminUser();
      allow delete: if isAdminUser();
    }

    // Payouts
    match /Payouts/{payoutId} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.testerId) || 
                     isCampaignOwner(resource.data.campaignId) || 
                     isAdminUser();
      allow create: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      allow update: if isCampaignOwner(request.resource.data.campaignId) || isAdminUser();
      allow delete: if false;
    }

    // Payout Logs
    match /PayoutLogs/{logId} {
      allow read: if isAdminUser();
      allow create, update, delete: if isAdminUser();
    }
    
    // Ships Logs
    match /ships_logs/{logId} {
      allow read: if true;
      allow write: if false; // Only written via API
    }
    
    // Activities
    match /activities/{activityId} {
      allow read: if true;
      allow write: if false; // Only written via API
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
    }

    // Wallet index — maps wallet addresses to Firebase UIDs.
    // Used by signInWithWallet to look up existing accounts.
    // Read: any authenticated user can look up wallets.
    // Write: authenticated users can only write/delete entries where uid == their own.
    match /wallet_index/{walletAddress} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Agent cache — cached AI agent analysis results.
    // Read: anyone can view cached results.
    // Write: only server-side scripts via admin SDK (rules bypassed).
    // The firebase-admin SDK bypasses security rules, so `write: if false`
    // still allows your API routes to write while blocking malicious clients.
    match /agentCache/{cacheId} {
      allow read: if true;
      allow write: if false;
    }

    // Agent runs — execution logs for agent operations (scout, execute, etc.).
    // Read: publicly visible so the landing page LiveAgentTicker can show recent activity.
    // Write: only server-side scripts via admin SDK (rules bypassed).
    match /agent_runs/{runId} {
      allow read: if true;
      allow write: if false;
    }

    // Payout attestations — verification results from the PayoutVerifier agent.
    // Read: publicly visible so anyone can verify a payout claim.
    // Write: only server-side via admin SDK (rules bypassed).
    match /payoutAttestations/{attestationId} {
      allow read: if true;
      allow write: if false;
    }

    // Builder credentials — per-builder aggregate of hackathon win attestations.
    // Each doc: { builderId, totalPrizesWon, totalPrizesVerified, hackathonWins[], lastPayoutAt, payoutReliability }
    // Read: any authenticated user can view credentials.
    // Write: only server-side via admin SDK (rules bypassed).
    match /builderCredentials/{builderId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Hackathon winners — verified past hackathon winners.
    // Each doc: { uid, wins[], totalWins, lastVerifiedAt, ... }
    // Read: any authenticated user can view winner status.
    // Write: only server-side via admin SDK (rules bypassed — written by admin API).
    match /hackathonWinners/{winnerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Winner claims — pending hackathon winner verification requests.
    // Each doc: { uid, hackathonName, announcementUrl, githubRepo, outcome, status, ... }
    // Read: admin-only (contains user-submitted proof links).
    // Write: only server-side via admin SDK (rules bypassed — submitted+reviewed by API).
    match /winnerClaims/{claimId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Platform stats — public read for lead magnet progress bar.
    // Single doc: platformStats/stats.
    // Write: only server-side via admin SDK (rules bypassed).
    match /platformStats/{statId} {
      allow read: if true;
      allow write: if false;
    }

    // Circle idempotency keys — prevents duplicate transaction submissions.
    // Read: admin-only (operational debugging).
    // Write: only server-side via admin SDK (rules bypassed).
    match /circleIdempotency/{keyId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Transaction statuses — push-based updates from Circle webhooks.
    // Read: admin-only.
    // Write: only server-side via admin SDK (rules bypassed — written by webhook handler).
    match /transactionStatuses/{txId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Webhook logs — audit trail for incoming Circle webhook notifications.
    // Read: admin-only.
    // Write: only server-side via admin SDK (rules bypassed — written by webhook handler).
    match /webhookLogs/{logId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Agent sponsorships — platform-funded first agent calls per user.
    // Written by /api/agent/* via admin SDK; read is admin-only (economics audit).
    match /agentSponsorships/{sponsorshipId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Funnel events — step-to-outcome instrumentation (login, claim, backing).
    // Written by /api/analytics/event via admin SDK; read is admin-only.
    match /funnelEvents/{eventId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Referrals — tracks referral attribution for new users.
    // Each doc: { referralCode, referredUid, referredAt, bonusXp, status }
    // Read: only the referred user can read their own referral record.
    // Write: only server-side via admin SDK, except the initial create
    // which a user can write for their own uid during sign-up.
    match /referrals/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if false;
    }
  }
}
